{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile in the EST-USMBA Library",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 150 },
        "fullName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["ROLE_GERANT", "ROLE_ETUDIANT"] },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "fullName", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered library users and roles"
    }
  }
}
